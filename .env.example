# Copy this file to `.env` and fill in real values.
# The `.env` file is gitignored — never commit it.

# Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-your-generated-key

# True for local development, False in production.
DEBUG=True

# Comma-separated list of host names this app will respond to.
# Add your real domain for production, e.g. ALLOWED_HOSTS=lactea.example.com,127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost


# --- Stripe (T2 purchase gate for the Galactra skin) ---
# Get TEST keys at https://dashboard.stripe.com/test/apikeys after signup.
# Live (pk_live_ / sk_live_) keys never touch this repo — only test values here.
# STRIPE_PRICE_ID is created in the Stripe Dashboard under Product catalog.
# STRIPE_WEBHOOK_SECRET is produced by `stripe listen --forward-to ...` in dev
# or the Dashboard webhook config in prod.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
